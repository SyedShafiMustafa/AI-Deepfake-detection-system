<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:padding="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Photo"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose where to get it from"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12.5sp"
        android:layout_marginTop="4dp"/>

    <!-- Camera option -->
    <LinearLayout
        android:id="@+id/btnSheetCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_option"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvSheetCameraIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="26sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetCameraTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSheetCameraDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture right now"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11.5sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="@color/colorAccent"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- Gallery option -->
    <LinearLayout
        android:id="@+id/btnSheetGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_option"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvSheetGalleryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️"
            android:textSize="26sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetGalleryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSheetGalleryDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick from your device"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11.5sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="@color/colorAccent"
            android:textSize="18sp"/>
    </LinearLayout>
</LinearLayout>